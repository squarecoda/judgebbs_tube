{% set widgets = [
	{
		heading: 'Profile',
		body: include('widgets/profile.twig'),
		cta: {
			text: 'View Profile',
			url: '#profile',
		},
	},
	{
		heading: 'Assigned Playlists',
		body: include('widgets/assigned-playlists.twig'),
		cta: {
			text: 'See All',
			url: '#saved-videos',
		},
	},
] %}

<div class="widget-wrapper">

	{% for widget in widgets %}
	<div class="widget">
		<div class="widget-heading">{{ widget.heading }}</div>
		<div class="widget-body">{{ widget.body }}</div>
		<div class="widget-cta">
			<a class="scfe-cta-button" href="{{ widget.cta.url }}">{{ widget.cta.text }}</a>
		</div>
	</div>
	{% endfor %}

</div>
