{% set assigned_playlists = fn('get_playlists', 'assigned') %}
{% set personal_playlists = fn('get_playlists', 'personal') %}
{% set public_playlists = fn('get_playlists', 'public') %}

{% set current_judge_id = fn('get_current_judge_id') %}


{% set widgets = [
	{
		heading: 'Profile',
		body: include('widgets/profile.twig'),
		cta: {
			text: 'View Profile',
			url: '#profile',
		},
	},
	{
		heading: 'Assigned Playlists',
		body: include('widgets/assigned-playlists.twig', { show_due_date: true }),
		cta: {
			text: 'All Playlists',
			url: '/playlists',
		},
	},
	{
		heading: 'Personal Playlists',
		body: include('playlist-landing-results.twig', { results: personal_playlists, limit: 3 }),
		cta: {
			text: 'All Playlists',
			url: '/playlists',
		},
	},
] %}

<div class="widget-wrapper">

	{% for widget in widgets %}
	<div class="widget">
		<div class="widget-heading">{{ widget.heading }}</div>
		<div class="widget-body">{{ widget.body }}</div>
		<div class="widget-cta">
			<a class="scfe-cta-button" href="{{ widget.cta.url }}">{{ widget.cta.text }}</a>
		</div>
	</div>
	{% endfor %}

</div>
