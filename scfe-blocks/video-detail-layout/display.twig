{% if get.playlist and get.order %}
	{% set playlist_id = fn('get_playlist_from_slug', get.playlist) %}
{% endif %}

<div class="video-display">

	{% if playlist_id %}
	<div class="sticky-header full">
		{{ include('video-detail/playlist-header.twig') }}
	</div>
	{% endif %}

	<div class="video large">
		{{ include('video-detail/video.twig') }}
	</div>

	<div class="my-score-wrapper">
		{{ include('video-detail/my-score.twig') }}
	</div>

	<div class="data">
		{{ include('video-detail/data.twig') }}
	</div>

	<div class="scores large">
		{{ include('reference-scores.twig') }}
	</div>

	{% if playlist_id %}
	<div class="sticky-footer full">
		{{ include('video-playlist-pagination.twig') }}
	</div>
	{% endif %}

</div>