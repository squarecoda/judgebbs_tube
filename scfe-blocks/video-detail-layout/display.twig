{% if get.playlist and get.order %}
	{% set playlist_id = fn('get_playlist_from_slug', get.playlist) %}
{% endif %}
	
<div class="video-display">

	{% if video_url %}
	<div class="video large">
		{{ video_url ? fn('do_shortcode', '[sc_video_embed link="' ~ video_url ~ '"]') }}
	</div>
	{% endif %}

	<div class="data">
		{{ fn('get_the_title') }}
	</div>

	<div class="scores large">
		{% include 'reference-scores.twig' %}
	</div>

	{% if playlist_id %}
	<div class="sticky-footer full">
		{% include 'video-playlist-pagination.twig' %}
	</div>
	{% endif %}

</div>