{% set videos = fn('get_video_search_results') %}

{% set modal_id = 'add-video-to-playlist-modal' %}

<div class="video-search-wrapper">
	
	{% include 'search-filters.twig' %}

	<div class="video-list">

		<h3 style="margin: 0;">{{ videos.pagination.found_posts }} {{ videos.pagination.found_posts == 1 ? 'video' : 'videos'}} found</h3>

		{% for video in videos.results %}
		<div class="video-post">
			<div class="add-to-playlist scfe-modal-trigger" video_id="{{ video.id }}" title="Add to playlist(s)" target="#{{ modal_id }}" video_title="{{ video.song_title }}" video_contestant="{{ video.contestant.title }}" video_date="{{ video.date }}" judge_id="{{ fn('get_current_judge_id') }}">
				<span class="fas fa-plus"></span>
			</div>
			<div class="video-link">
				<a class="song-title" href="{{ video.url }}">{{ video.song_title }}</a>
				<div class="subtitle">
					<div class="contestant">{{ video.contestant.title }}</div>
					<div class="video-date">{{ video.date }}</div>
				</div>
			</div>
		</div>
		{% endfor %}
	</div>

	<div class="sticky-footer">
	{% include 'pagination.twig' with { pagination: videos.pagination } %}
	</div>

</div>

{{ include('scfe-modal.twig', {
	modal_header: '<h4>Add video to playlist(s)</h4><div class="modal-video-title"></div>',
	modal_body: '',
}) }}
