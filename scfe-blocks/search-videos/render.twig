{% set videos = fn('get_video_search_results') %}

<div class="video-search-wrapper">
	
	{% include 'search-filters.twig' %}

	<div class="video-list">

		<h3 style="margin: 0;">{{ videos.pagination.found_posts }} {{ videos.pagination.found_posts == 1 ? 'video' : 'videos'}} found</h3>

		{% for video in videos.results %}
		<div class="video-post">
			<a class="video-link" href="{{ video.url }}">
				<div class="song-title">{{ video.song_title }}</div>
				<div class="contestant">{{ video.contestant.title }}</div>
			</a>
		</div>
		{% endfor %}
	</div>

	<div class="sticky-footer">
	{% include 'pagination.twig' with { pagination: videos.pagination } %}
	</div>

</div>
