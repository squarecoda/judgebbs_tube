{% set current_judge_id = current_judge_id ?: fn('get_current_judge_id') %}
{% set videos = fn('json_decode', fn('base64_decode', videos)) %}

{% set score_number = 0 %}
{% set video_number = 0 %}

<div class="playlist-display">

	<div class="playlist-videos">
		{% for video in videos %}
			{% set video = fn('get_video_array', video.video, current_judge_id) %}
			<a class="video-post" href="{{ video.url }}?playlist={{ post_slug }}&order={{ loop.index }}">
				{% include 'playlist-video-score.twig' %}
				<div class="video-link">
					<div class="song-title">#{{ loop.index }} {{ video.song_title }}</div>
					<div class="contestant">{{ video.contestant.title }}</div>
				</div>
			</a>

			{% set video_number = video_number + 1 %}
			{% if video.score %}
				{% set score_number = score_number + 1 %}
			{% endif %}
		{% endfor %}
	</div>

	<div class="sticky-footer">
		<div class="total-scores">
			<div class="circle-progress {{ fn('get_judge_category', current_judge_id) }}" amount="{{ score_number }}" total="{{ video_number }}"></div>
			<div class="score-text">{{ score_number }}/{{ video_number }} scores recorded</div>
		</div>
	</div>
</div>
