{% if results|length %}
<div class="playlist-results">
	{% for playlist in (limit is defined ? results|slice(0, limit) : results) %}
	<div class="playlist-result">
		{{ include('playlist-percentage.twig', { playlist_details: playlist, show_title: true }) }}
	</div>
	{% endfor %}
</div>
{% else %}
	No results
{% endif %}

