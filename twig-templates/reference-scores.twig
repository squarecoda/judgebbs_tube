{% set id = fn('get_the_id') %}

{% set is_admin = false %}
{% set is_admin = fn('current_user_can', 'administrator') %}

{% set reference_scores = fn('get_reference_scores', id) %}

<div class="reference-score-wrapper" post_id="{{ id }}">

	<div class="reference-score-wrapper-heading">Reference Scores</div>

	<div class="reference-score-display-wrapper">

		{# Overall Score #}
		<div class="reference-score-display overall" title="Automatically calculated">
			<div class="reference-score-display-heading">Overall</div>
			<div class="reference-score-display-body">
				<div class="score-view">
					<span class="fas fa-cog fa-spin"></span>
				</div>
			</div>
			{% if is_admin %}
			<div class="reference-score-display-footer">
				Auto-calculated
			</div>
			{% endif %}
		</div>

	{% for category, update_history in reference_scores %}
		{% include 'reference-score.twig' %}
	{% endfor %}
	</div>

</div>

