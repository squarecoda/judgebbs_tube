{% set show_title = show_title|default(false) %}
{% set show_due_date = show_due_date|default(false) %}

{% set creator = fn('get_playlist_creator', playlist_details.id) %}
{% set due_date = fn('get_playlist_due_date', playlist_details.id) %}
{% set public = fn('get_post_meta', playlist_details.id, 'public', true) %}
{% set video_count = fn('get_video_count', playlist_details.id) %}

{% set creator = '' %}

<div class="total-scores">
	{% if playlist_details.score_number is defined and playlist_details.video_number is defined %}
	<div class="circle-progress {{ fn('get_judge_category', current_judge_id) }}" amount="{{ playlist_details.score_number }}" total="{{ playlist_details.video_number }}"></div>
	{% elseif public %}
	<div class="fas fa-globe" title="Public"></div>
	{% else %}
	<div class="fas fa-key" title="Private"></div>
	{% endif %}
	<div class="score-text">
		{% if show_title %}
		<a class="playlist-title" href="{{ fn('get_the_permalink', playlist.id) }}{{ current_judge_id ? '?judge_id=' ~ current_judge_id }}">
			{{ fn('get_the_title', playlist_details.id) }} 
		</a>
		{% endif %}

		<div class="playlist-subtitle">

			{% if playlist_details.score_number is defined and playlist_details.video_number is defined %}
			<div class="score-total">{{ playlist_details.score_number }}/{{ playlist_details.video_number }} complete</div>
			{% else %}
			<div class="video-count" title="Video Count"><span class="fas fa-video"></span> {{ video_count }}</div>
			{% endif %}

			{% if creator %}
			<div class="creator" title="Creator"><span class="fas fa-user"></span> {{ creator }}</div>
			{% endif %}

			{% if due_date and show_due_date %}
			<div class="due-date" title="Due Date"><span class="fas fa-calendar-alt"></span> {{ due_date }}</div>
			{% endif %}

		</div>
	</div>
	{% if add_to_playlist %}
	<div class="fas fa-plus" title="Add to playlist"></div>
	<div class="fas fa-minus" title="Remove from playlist"></div>
	<div class="fas fa-check" title="Added to playlist"></div>
	<div class="fas-wrapper">
		<div class="fas fa-cog fa-spin" title="Processing"></div>
	</div>
	{% endif %}
</div>
